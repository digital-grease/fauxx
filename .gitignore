# Local working/reference docs (e.g. the E13 handoff brief + sync protocol copy).
# The canonical sync contract lives in fauxx-desktop/docs/SYNC_PROTOCOL.md.
docs/
# Local one-off dev/AI-review tools stay ignored; the E7 persona-distribution
# builder is committed (it regenerates a shipped asset and must be reviewable).
scripts/*
!scripts/build_persona_distribution.py
!scripts/backfill_city_regions.py
# E4 (#180) broker-inference co-occurrence builder: regenerates a shipped asset, must be reviewable.
!scripts/build_cooccurrence.py
# #353 crawl-list link-rot checker: run monthly by .github/workflows/crawl-link-check.yml.
!scripts/check_crawl_urls.py
# #322 site-popularity builder: regenerates assets/site_popularity.json from a Tranco list.
!scripts/build_site_popularity.py
# #322 category-popularity builder: regenerates assets/category_popularity.json from SimilarWeb data.
!scripts/build_category_popularity.py
# #322 landing-page intents: names the IAB purchase-intent nodes and checks the exclusions.
!scripts/build_purchase_intents.py
# #322 item 12: where location spoofing may go, clear of sensitive places (Overture Maps, OpenStreetMap).
!scripts/build_location_anchors.py
# JVM attach artifacts from jstack/debugger sessions
.attach_pid*
