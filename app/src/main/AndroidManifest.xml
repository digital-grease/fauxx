<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Network -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />

    <!-- Encrypted LAN persona sync (E13 #178). CHANGE_WIFI_MULTICAST_STATE lets us
         hold a MulticastLock so NsdManager can receive inbound mDNS multicast (Android
         drops it by default). CAMERA is requested at runtime only when the user taps
         "Scan to pair"; a manual paste fallback exists, so the camera is not required. -->
    <uses-permission android:name="android.permission.CHANGE_WIFI_MULTICAST_STATE" />
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-feature android:name="android.hardware.camera.any" android:required="false" />

    <!-- Location spoofing.
         ACCESS_FINE_LOCATION / ACCESS_COARSE_LOCATION are deliberately NOT declared. The app
         only ever WRITES through the mock-location test provider, which is gated by the
         ACCESS_MOCK_LOCATION appop, not by the runtime location permissions. Verified on
         Android 14: addTestProvider / setTestProviderEnabled / setTestProviderLocation all
         succeed with the appop alone. Declaring them cost the app a "requests location" entry
         in the OS permission list and in F-Droid metadata with nothing asking for them at
         runtime, so they were never granted anyway. -->
    <!-- ACCESS_MOCK_LOCATION is declared in src/full/AndroidManifest.xml so the
         F-Droid build appears in Developer Options → "Select mock location app".
         Play flavor intentionally omits it (Play Store policy). -->

    <!-- Foreground service (flavor-specific FGS type permission lives in
         src/play/AndroidManifest.xml and src/full/AndroidManifest.xml) -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- LAN sync uses specialUse, like the engine (see src/full and src/play overlays, which
         declare this permission for PhantomForegroundService).

         It used to be dataSync, on the assumption that a session is short because "the service is
         torn down when the user leaves". That was never true: nothing stops the service when the
         user leaves the Sync screen, so it accumulated runtime, blew through dataSync's 6h/24h cap
         (Android 15+), and the platform killed it — the ForegroundServiceDidNotStopInTimeException
         crashes in #248/#249. specialUse has no cap, which is the same reason the engine moved to
         it in #64/#65. dataSync was also the wrong category on its own terms: it describes moving
         the user's data to and from the CLOUD, and this never leaves the local network. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />

    <!-- Boot receiver -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <!-- Wake lock for background work -->
    <uses-permission android:name="android.permission.WAKE_LOCK" />

    <!-- Battery optimization -->
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />

    <application
        android:name=".FauxxApp"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:localeConfig="@xml/locales_config"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.Fauxx"
        android:usesCleartextTraffic="false"
        android:networkSecurityConfig="@xml/network_security_config">

        <activity
            android:name=".ui.MainActivity"
            android:exported="true"
            android:theme="@style/Theme.Fauxx"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Foreground Service. The foregroundServiceType attribute is set per-flavor;
             both flavors use specialUse + PROPERTY_SPECIAL_USE_FGS_SUBTYPE
             (set in src/play/AndroidManifest.xml and src/full/AndroidManifest.xml). -->
        <service
            android:name=".service.PhantomForegroundService"
            android:exported="false" />

        <!-- Encrypted LAN persona sync session (E13 #178). A user-initiated specialUse
             foreground service that holds the MulticastLock, advertises/browses over
             NsdManager, and runs the inbound sealed-frame listener only while the user
             has sync enabled. Never auto-started at boot. See the FOREGROUND_SERVICE_SPECIAL_USE
             comment above for why this is specialUse rather than dataSync (#248, #249). -->
        <service
            android:name=".service.SyncForegroundService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Encrypted peer-to-peer synchronization of the user's own synthetic-persona state between their paired devices, over the local network only. The session is user-initiated and never contacts a remote server, so it does not fit dataSync (defined as transferring the user's data to or from the cloud). It must hold a multicast lock and an inbound listening socket for as long as the user leaves sync enabled, because two paired devices can only converge while both are simultaneously reachable on the LAN." />
        </service>

        <!-- Boot receiver -->
        <receiver
            android:name=".service.BootReceiver"
            android:exported="true"
            android:enabled="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>

        <!-- Scheduled (quiet-hours) auto-resume alarm receiver (#126). Not exported: only the
             app's own exact alarm (full flavor, see src/full USE_EXACT_ALARM) targets it. -->
        <receiver
            android:name=".service.AlarmResumeReceiver"
            android:exported="false" />

        <!-- Headless "Start" action on the resume notification (#121). Not exported: only the
             app's own notification action targets it. -->
        <receiver
            android:name=".service.StartEngineReceiver"
            android:exported="false" />

        <!-- FileProvider for sharing crash reports and debug logs -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

        <!-- Hilt WorkManager integration -->
        <provider
            android:name="androidx.startup.InitializationProvider"
            android:authorities="${applicationId}.androidx-startup"
            android:exported="false"
            tools:node="merge">
            <meta-data
                android:name="androidx.work.WorkManagerInitializer"
                android:value="androidx.startup"
                tools:node="remove" />
        </provider>

        <!-- AppCompat per-app-language backport (Android 12 and below). Holds the
             selected app locale across process restarts. enabled=false because the
             service is never actually started — it exists so the AppCompat library
             can read its meta-data. -->
        <service
            android:name="androidx.appcompat.app.AppLocalesMetadataHolderService"
            android:enabled="false"
            android:exported="false">
            <meta-data
                android:name="autoStoreLocales"
                android:value="true" />
        </service>

        <!-- Safe Browsing disabled app-wide. The app's only WebViews are the phantom pool,
             which would otherwise disclose every synthetic destination (including SERP URLs,
             now that search routes through it) to Google Safe Browsing in real time. The pool
             only loads curated, blocklist-gated URLs. Dynamic / on-device malware avoidance is
             tracked as a follow-up. (#168/#169 M1) -->
        <meta-data
            android:name="android.webkit.WebView.EnableSafeBrowsing"
            android:value="false" />

    </application>

</manifest>
